{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalods.local/schemas/unified-event-v1.schema.json",
  "title": "CausalODS UnifiedEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_name", "event_type", "signal_type", "event_timestamp", "schema_version"],
  "properties": {
    "event_id": {"$ref": "#/$defs/id"},
    "event_name": {"$ref": "#/$defs/nonEmpty"},
    "event_type": {"$ref": "#/$defs/nonEmpty"},
    "signal_type": {"enum": ["trace", "log", "metric", "business_event"]},
    "event_timestamp": {"$ref": "#/$defs/utcTimestamp"},
    "observed_timestamp": {"$ref": "#/$defs/nullableUtcTimestamp"},
    "ingested_timestamp": {"$ref": "#/$defs/nullableUtcTimestamp"},
    "trace_id": {"$ref": "#/$defs/nullableId"},
    "span_id": {"$ref": "#/$defs/nullableId"},
    "parent_span_id": {"$ref": "#/$defs/nullableId"},
    "trace_flags": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
    "trace_state": {"$ref": "#/$defs/nullableNonEmpty"},
    "span_links": {"type": "array", "items": {"type": "object"}},
    "correlation_id": {"$ref": "#/$defs/nullableId"},
    "business_entity_type": {"$ref": "#/$defs/nullableNonEmpty"},
    "business_entity_id": {"$ref": "#/$defs/nullableId"},
    "business_operation": {"$ref": "#/$defs/nullableNonEmpty"},
    "business_outcome": {"$ref": "#/$defs/nullableNonEmpty"},
    "service_name": {"$ref": "#/$defs/nullableNonEmpty"},
    "service_instance_id": {"$ref": "#/$defs/nullableId"},
    "service_version": {"$ref": "#/$defs/nullableNonEmpty"},
    "deployment_environment": {"$ref": "#/$defs/nullableNonEmpty"},
    "severity": {"$ref": "#/$defs/nullableNonEmpty"},
    "error_type": {"$ref": "#/$defs/nullableNonEmpty"},
    "status_code": {"type": ["string", "integer", "null"]},
    "metric_name": {"$ref": "#/$defs/nullableNonEmpty"},
    "metric_unit": {"$ref": "#/$defs/nullableNonEmpty"},
    "metric_value": {"type": ["number", "null"]},
    "metric_aggregation": {"$ref": "#/$defs/nullableNonEmpty"},
    "attributes": {"type": "object"},
    "resource_attributes": {"type": "object"},
    "instrumentation_scope": {"type": "object"},
    "schema_version": {"const": "unified-event-v1"},
    "source_reference": {"$ref": "#/$defs/nullableNonEmpty"},
    "source_dataset": {"$ref": "#/$defs/nullableNonEmpty"},
    "missing_fields": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
    "late_arrival_ms": {"type": ["number", "null"], "minimum": 0},
    "data_quality_flags": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "nullableNonEmpty": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/nonEmpty"}]},
    "id": {"type": "string", "minLength": 1, "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"},
    "nullableId": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "utcTimestamp": {"type": "string", "format": "date-time"},
    "nullableUtcTimestamp": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/utcTimestamp"}]}
  }
}
