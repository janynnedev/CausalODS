{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalods.local/schemas/derived-evidence-v1.schema.json",
  "title": "CausalODS DerivedEvidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "relation_type",
    "source_event_ids",
    "target_event_id",
    "inferred_at",
    "source_component",
    "confidence",
    "attributes",
    "schema_version"
  ],
  "properties": {
    "evidence_id": {"$ref": "#/$defs/id"},
    "relation_type": {"$ref": "#/$defs/nonEmpty"},
    "source_event_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "target_event_id": {"$ref": "#/$defs/id"},
    "inferred_at": {"type": "string", "format": "date-time"},
    "source_component": {"$ref": "#/$defs/nonEmpty"},
    "confidence": {
      "anyOf": [
        {"type": "null"},
        {"type": "number", "minimum": 0, "maximum": 1}
      ]
    },
    "attributes": {"type": "object"},
    "schema_version": {"const": "derived-evidence-v1"}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
    }
  }
}
