{
  "index_patterns": ["causalods-v3-incidents*"],
  "priority": 300,
  "template": {
    "settings": {"index.mapping.total_fields.limit": 300, "number_of_shards": 1, "number_of_replicas": 0},
    "mappings": {
      "dynamic": false,
      "properties": {
        "projection_version": {"type": "keyword"},
        "incident_id": {"type": "keyword"},
        "workflow_key": {"type": "keyword"},
        "analysis_window_start": {"type": "date"},
        "analysis_window_end": {"type": "date"},
        "services": {"type": "keyword"},
        "modalities": {"type": "keyword"},
        "missing_modalities": {"type": "keyword"},
        "event_count": {"type": "integer"},
        "late_event_count": {"type": "integer"},
        "association_quality": {"type": "double"},
        "correlation_ids": {"type": "keyword"},
        "trace_ids": {"type": "keyword"},
        "graph_node_count": {"type": "integer"},
        "graph_edge_count": {"type": "integer"},
        "business_entities_json": {"type": "keyword", "index": false, "doc_values": false},
        "provenance_json": {"type": "keyword", "index": false, "doc_values": false},
        "quality_json": {"type": "keyword", "index": false, "doc_values": false},
        "graph_rule_versions_json": {"type": "keyword", "index": false, "doc_values": false},
        "graph_nodes_json": {"type": "keyword", "index": false, "doc_values": false},
        "graph_edges_json": {"type": "keyword", "index": false, "doc_values": false},
        "payload_hash": {"type": "keyword"}
      }
    }
  },
  "_meta": {"schema_version": "causalods-v3-incidents-template-v1", "retention": "external-policy-required"}
}
